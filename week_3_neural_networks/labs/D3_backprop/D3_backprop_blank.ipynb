    "print(f\"unchanged: \"\n",
    "      f\"{math.isclose(today_out[0, 0].item(), yesterday['lecture_network']['output'], abs_tol=1e-8)}\")\n",
    "print(f\"\\nX {tuple(X.shape)} | y {tuple(y.shape)} | network {N_IN}-{N_HIDDEN}-{N_OUT}\")\n",
