    "\n",
    "# -- my solution: start --\n",
    "def bce_loss(y_true, y_pred):\n",
    "    y_pred = torch.clamp(y_pred, 1e-12, 1 - 1e-12)\n",
    "    return -torch.mean(y_true * torch.log(y_pred) + (1 - y_true) * torch.log(1 - y_pred))\n",
